* Minimal SKY130 5V-device library extracted from google/skywater-pdk-libs-sky130_fd_pr (Apache-2.0)
* Contains only sky130_fd_pr__nfet_g5v0d10v5 and sky130_fd_pr__pfet_g5v0d10v5 for the 5 corners.

.lib tt
.option scale=1.0u
.include "lod.spice"
.param hv_dlc_rotweak=0 sky130_fd_pr__nfet_g5v0d10v5__dlc_rotweak=0 sky130_fd_pr__pfet_g5v0d10v5__dlc_rotweak=0
.include "nfet_g5v0d10v5/sky130_fd_pr__nfet_g5v0d10v5__tt.corner.spice"
